{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nodus_db;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "NodusApi",
    "Audience": "NodusClient",
    "ExpiresMinutes": 10080
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "AllowedClientIds": []
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_SMTP_EMAIL",
    "Password": "YOUR_SMTP_APP_PASSWORD",
    "FromEmail": "YOUR_SMTP_EMAIL"
  },
  "Agent": {
    "Provider": "OpenAICompatible",
    "ResearchCacheHours": 168,
    "CheckLinks": true,
    "OpenAICompatible": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "Model": "gemini-3.8-flash",
      "FallbackModels": [
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.1-flash-lite"
      ],
      "FallbackAfterSeconds": 60,
      "TimeoutSeconds": 150,
      "MaxOutputTokens": 32000,
      "ReasoningEffort": "low"
    },
    "Tavily": {
      "MaxResultsPerQuery": 5
    }
  },
  "RateLimits": {
    "Generate": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    }
  }
}